# ==============================================================================
# Pre-Headline Intelligence — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in the values for your environment.
# DO NOT commit real API keys or credentials to version control.
# ==============================================================================

# Application Settings
APP_NAME="Pre-Headline Intelligence"
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-secure-random-secret-key-in-production
API_V1_STR=/api/v1

# Database Configuration (PostgreSQL + pgvector)
# Example: postgresql+asyncpg://postgres:postgres@localhost:5432/pre_headline_intel
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pre_headline_intel
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/pre_headline_intel
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pre_headline_intel
POSTGRES_PORT=5432

# Redis & Celery Background Processing
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Intelligence Ingestion Feeds
GDELT_API_URL=https://api.gdeltproject.org/api/v2/gkg/gkg
GDELT_ENABLED=true
NEWS_API_KEY=your_licensed_news_api_key_here
NEWS_API_BASE_URL=https://newsapi.org/v2

# LLM & Reasoning Engine (Strictly for Grounded Copilot & Score Explanation Caching)
LLM_PROVIDER=openai
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_CACHE_ENABLED=true

# Multilingual Embeddings Model
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384

# Media Storage Configuration
MEDIA_STORAGE_BACKEND=local
MEDIA_STORAGE_PATH=./uploads
MEDIA_MAX_FILE_SIZE_MB=50

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
